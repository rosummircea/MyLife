NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# Temporary interface access as Mircea; does not authenticate with Supabase.
# Set true in .env.local during UI development, false to restore login.
MYLIFE_DEV_ACCESS=false

# Optional local-only snapshot exported from the connected Supabase project.
# Absolute path outside the repository. Used only on localhost/127.0.0.1,
# with MYLIFE_DEV_ACCESS=true, and never on Vercel.
MYLIFE_LOCAL_SNAPSHOT_PATH=
